# Copy to .env.local and fill in from Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Google Maps (map tiles, addresses, place search, road routes) — see docs/GOOGLE_MAPS.md.
# Without it the apps use OpenStreetMap. Public by design: restrict it in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
